{
  "name": "vent-sim-mvp",
  "version": "1.0.0",
  "description": "Browser-based mechanical ventilator simulator for clinical education",
  "main": "index.html",
  "scripts": {
    "test": "node tools/run-engine-tests.mjs",
    "serve": "node tools/serve.mjs",
    "test:visual": "node tools/run-browser-tests.mjs --visual",
    "test:visual:update": "node tools/run-browser-tests.mjs --visual --update-snapshots",
    "test:visual:docker": "node tools/run-visual-docker.mjs",
    "test:browser": "node tools/run-browser-tests.mjs",
    "shots": "node scratch/shot.cjs"
  },
  "keywords": [
    "mechanical-ventilation",
    "simulation",
    "respiratory-therapy",
    "education",
    "waveforms"
  ],
  "author": "Chris <christian.striggow@outlook.com>",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
